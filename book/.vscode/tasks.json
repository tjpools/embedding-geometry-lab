{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Book: Refresh Metrics",
      "type": "shell",
      "command": "python3 book/wordcount_report.py && python3 book/analysis_throughput/chapter_metrics_suite.py && python3 book/analysis_throughput/chapter_heatmap.py",
      "options": {
        "cwd": "${workspaceFolder}/.."
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Book: Build EPUB/PDF",
      "type": "shell",
      "command": "bash book/build_book.sh",
      "options": {
        "cwd": "${workspaceFolder}/.."
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Book: Update All Artifacts",
      "type": "shell",
      "command": "bash book/update_artifacts.sh",
      "options": {
        "cwd": "${workspaceFolder}/.."
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}